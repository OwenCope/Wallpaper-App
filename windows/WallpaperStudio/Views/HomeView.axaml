<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WallpaperStudio.ViewModels"
             x:Class="WallpaperStudio.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <ScrollViewer>
        <StackPanel Margin="32,28,32,24" Spacing="4">
            <TextBlock Text="Featured" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>

            <ItemsControl ItemsSource="{Binding Featured}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PhotoVM">
                        <Border Width="288" Height="162" Margin="0,0,16,16" CornerRadius="14"
                                Background="#15151D" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                <Border VerticalAlignment="Bottom" Background="#99000000" Padding="10,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Resolution}" Foreground="#E6FFFFFF"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Set" Command="{Binding SetWallpaperCommand}"
                                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                                CornerRadius="8" Padding="10,4" FontSize="12"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="BROWSE BY CATEGORY" Foreground="{DynamicResource Muted}" FontSize="11"
                       FontWeight="SemiBold" LetterSpacing="1" Margin="2,16,0,10"/>
            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryTile">
                        <Button Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenCategoryCommand}"
                                CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                                Padding="0" Margin="0,0,12,12" Cursor="Hand">
                            <Border Width="168" Height="104" CornerRadius="14" Background="{Binding Brush}">
                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"
                                           FontSize="14" Margin="12" VerticalAlignment="Bottom"/>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
